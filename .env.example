# Base de donnees (SQLite en local, Postgres conseille en production)
DATABASE_URL="file:./dev.db"

# NextAuth - genere une valeur avec: openssl rand -base64 32
NEXTAUTH_SECRET="remplace-moi-par-une-chaine-aleatoire-de-32-caracteres"
NEXTAUTH_URL="http://localhost:3000"

# Numero WhatsApp au format international SANS le "+" (RDC = 243)
NEXT_PUBLIC_WHATSAPP_NUMBER="243974332278"

# URL publique du site (sans slash final) - utilisee par le sitemap et l'Open Graph
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Analytics 4 (laisser vide pour desactiver le tracking)
NEXT_PUBLIC_GA_ID=""

# Compte administrateur cree par le seed.
# La double authentification n'est PAS pre-activee : elle se configure a la
# premiere connexion, sur /admin/setup-2fa. Changez ce mot de passe ensuite.
ADMIN_EMAIL="admin@humokolwezi.cd"
ADMIN_PASSWORD="ChangeMoi2026!"

# Second compte agent, pour tester le cloisonnement entre agents (facultatif)
AGENT_EMAIL="grace@humokolwezi.cd"
AGENT_PASSWORD="ChangeMoiAussi2026!"
